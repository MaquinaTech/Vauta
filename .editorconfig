# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.swift]
max_line_length = 140

[*.{sh,yml,yaml,rb}]
indent_size = 2

[*.{plist,entitlements}]
indent_style = tab

[*.md]
trim_trailing_whitespace = false
