"path.users.groups" = "Usuarios y grupos";

/* Name of Vauta's own Settings window, as the sentences that send the user to Settings → Models write it */
"path.vauta.settings" = "Ajustes";

/* Generic relation between two entities */
"related to" = "relacionado con";

/* VoiceOver: a speaker heard over the call, used after the speaker's name, as in “Ana, remote, 12:04” */
"remote" = "en remoto";

/* Touch ID prompt: “Vauta is trying to …” */
"restore a backup" = "restaurar una copia de seguridad";

/* VoiceOver: a block of spreadsheet rows; the arguments are the first and last row numbers */
"rows %lld to %lld" = "filas %lld a %lld";

/* Citation of a block of spreadsheet rows without a sheet name; the arguments are the first and last row numbers */
"rows %lld–%lld" = "filas %lld–%lld";

/* Settings → Speakers; a saved voice that the current model cannot use; the argument is the date the user confirmed the person agreed */
"saved %@" = "guardada el %@";

/* Settings → Speakers; a saved voice none of whose suggestions has been accepted yet; the argument is the date the user confirmed the person agreed */
"saved %@, no suggestion accepted yet" = "guardada el %@, aún sin sugerencias aceptadas";

/* Model kind tag in a menu */
"search by meaning" = "búsqueda por significado";

/* Joins two sentences of one paragraph: a space, empty in Japanese and Chinese */
"sentence.separator" = " ";

/* VoiceOver: a block of rows of a sheet; the arguments are the sheet name and the first and last row numbers */
"sheet %@, rows %lld to %lld" = "hoja %@, filas %lld a %lld";

/* Touch ID prompt: “Vauta is trying to …” */
"show your meetings and context" = "mostrar tus reuniones y tu contexto";

/* Citation of a presentation slide; the argument is its number
   VoiceOver: a presentation slide; the argument is its number */
"slide %lld" = "diapositiva %lld";

/* State: a meeting is being recorded right now (not the Settings pane) */
"state.recording" = "Grabando";

/* Status level, accessibility; not the OK button of an alert */
"status.ok" = "OK";

/* Network error reason: the destination check refused the address; lowercase, no final period */
"that address isn’t allowed" = "esa dirección no está permitida";

/* Network error reason: anything else; lowercase, no final period */
"the connection failed" = "ha fallado la conexión";

/* Network error reason; lowercase, no final period */
"the network connection was lost" = "se ha perdido la conexión de red";

/* Network error reason: TLS; lowercase, no final period */
"the secure connection failed" = "ha fallado la conexión segura";

/* Network error reason: DNS; lowercase, no final period */
"the server’s name can’t be found" = "no se encuentra el nombre del servidor";

/* Event editor: the meeting did not say what time the follow-up is */
"Time not said" = "Hora no indicada";

/* Copied answer: the claim's quote was found in the transcript */
"verified" = "verificada";

/* Relation between a person and a project */
"works on" = "trabaja en";

/* Words heard in the meeting between quotation marks (a question, or the line that names the next meeting); the argument is the quote. Use the quotation marks of the language */
"“%@”" = "«%@»";

/* Mention whose transcript was purged */
"“%@” (the transcript has expired)" = "«%@» (la transcripción ha caducado)";

/* No comment provided by engineer. */
"“%@” and “%@”" = "«%@» y «%@»";

/* Warning; the first argument is a person's name, the second the error */
"“%@” couldn’t be added. %@" = "No se ha podido añadir a «%@». %@";

/* No comment provided by engineer. */
"“%@” gets:" = "«%@» recibe:";

/* Meeting people row: who the Others channel is */
"“%@” is" = "«%@» es";

/* Server config error; argument is a host
   Server security warning; argument is a host name */
"“%@” is a name that could point outside your network. Add the server’s private certificate authority or a certificate pin." = "«%@» es un nombre que podría apuntar fuera de tu red. Añade la autoridad de certificación privada del servidor o un pin de certificado.";

/* Hint under the name field of the other participants when the user typed their own name; the argument is the channel name (Me) */
"“%@” is always you. Name the other participants here." = "«%@» siempre eres tú. Pon aquí el nombre de los demás participantes.";

/* Notification body; the first argument is a calendar event title, the second a sentence such as “Zoom is using the microphone.” */
"“%@” is in progress. %@" = "«%@» está en curso. %@";

/* No comment provided by engineer. */
"“%@” is then removed from the list." = "Después, «%@» se quita de la lista.";

/* Server config error; argument is a host */
"“%@” isn’t a local network address (10.x, 172.16–31.x, 192.168.x, 100.64–127.x, fc00::/7, fe80::/10, *.local, *.lan, *.home.arpa, *.internal or *.ts.net). Vauta never sends meetings to the internet." = "«%@» no es una dirección de la red local (10.x, 172.16–31.x, 192.168.x, 100.64–127.x, fc00::/7, fe80::/10, *.local, *.lan, *.home.arpa, *.internal o *.ts.net). Vauta nunca envía reuniones a internet.";

/* Server config error */
"“A model server on this Mac” only accepts 127.0.0.1, ::1 or localhost. For another computer, choose “A model server on your network”." = "«Un servidor de modelos en este Mac» solo acepta 127.0.0.1, ::1 o localhost. Para otro ordenador, elige «Un servidor de modelos en tu red».";

/* Settings → Live answers, under Sensitivity */
"“More answers” checks more of what is said, which uses more energy." = "«Más respuestas» revisa más de lo que se dice, y gasta más energía.";

/* Links to earlier meetings (post-meeting actions, Part B) */
"Already in Reminders (added %@)" = "Ya está en Recordatorios (añadido el %@)";
"Also suggests tasks and decisions that repeat earlier meetings. You decide on each one." = "También sugiere tareas y decisiones que repiten reuniones anteriores. Tú decides sobre cada una.";
"Changed since %@" = "Cambiada desde el %@";
"Couldn’t save the link" = "No se ha podido guardar el vínculo";
"Different from %@?" = "¿Distinta de la del %@?";
"Dismissed links" = "Vínculos descartados";
"Earlier: %@. Now: %@." = "Antes: %1$@. Ahora: %2$@.";

/* Transcript: under a line of the user's channel that repeats what the other participants said, because the microphone heard them from the speakers */
"Echo of your speakers" = "Eco de tus altavoces";
"Mark as Done" = "Marcar como hecha";

/* Edit menu: the action Undo takes back, marking a transcript line as an echo of the speakers again */
"Mark as Echo" = "Marcar como eco";
"Not Related" = "Sin relación";
"Not the Same" = "No es la misma";
"Open the earlier meeting at this item" = "Abrir la reunión anterior en este elemento";
"Same Decision" = "Misma decisión";
"Same Task" = "Misma tarea";
"Same decision as on %@" = "Misma decisión que la del %@";
"Same decision as on %@?" = "¿Misma decisión que la del %@?";
"Same task as on %@" = "Misma tarea que la del %@";
"Same task as on %@?" = "¿Misma tarea que la del %@?";
"Show" = "Mostrar";
"Suggestion" = "Sugerencia";
"Undo Link" = "Deshacer vínculo";
"Yes, It Changed" = "Sí, cambió";
"carried over since %@" = "pendiente desde el %@";
"first decided on %@" = "decidida por primera vez el %@";
"replaces the decision of %@" = "sustituye la decisión del %@";
"Earlier decision: %@" = "Decisión anterior: %@";
"This task was carried over from earlier meetings" = "Esta tarea viene de reuniones anteriores";
"The suggestion changed while you were looking at it. The list is up to date now." = "La sugerencia ha cambiado mientras tanto. La lista ya está actualizada.";
"%@ · %@: “%@”" = "%@ · %@: «%@»";

/* Badge of the Apple Intelligence option in Settings → Models when this Mac cannot run Apple Intelligence */
"Not available on this Mac" = "No disponible en este Mac";

/* Label of the notes field of a reminder or an event in the editor; Apple’s Reminders and Calendar name this field (zh-Hans 备注), unlike the Notes tab of a meeting */
"event.field.notes" = "Notas";

"Transcription on this Mac" = "Transcripción en este Mac";

"Any call app. No bot joins the call." = "Cualquier app de llamadas. Ningún bot se une a la llamada.";

"Minutes and tasks" = "Actas y tareas";

"Decisions, tasks with owner and date, and open questions." = "Decisiones, tareas con responsable y fecha, y preguntas abiertas.";

"One question across your meetings, notes and files." = "Una pregunta sobre tus reuniones, notas y archivos.";

"Private" = "Privado";

"Audio is never saved. No account, no analytics." = "El audio nunca se guarda. Sin cuenta ni analíticas.";

/* Panel tip title while recording: the sound comes out of the Mac’s speakers, a display or AirPlay, not headphones */
"The meeting is playing through speakers" = "La reunión suena por los altavoces";

/* Panel tip under “The meeting is playing through speakers” */
"The microphone hears the other participants too. Vauta leaves their echo out of the minutes, and headphones avoid it." = "El micrófono también oye a los demás participantes. Vauta deja su eco fuera de las actas; con auriculares no ocurre.";
