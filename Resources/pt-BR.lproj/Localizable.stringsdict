<!-- SPDX-License-Identifier: Apache-2.0
     SPDX-FileCopyrightText: 2026 Nicolás López de Lerma López
     Brazilian Portuguese (pt-BR) plural strings. CLDR categories for pt: "one" (0 and 1) and "other";
     "zero" gives 0 the plural form ("0 reuniões", not "0 reunião").
     See docs/TRANSLATING.md. -->
<plist version="1.0">
<dict>
	<key>%@ · %lld chat models, %lld for search by meaning</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$@ · %2$#@chat@, %3$#@embedding@</string>
		<key>chat</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>zero</key>
			<string>%2$lld modelos de chat</string>
			<key>one</key>
			<string>%2$lld modelo de chat</string>
			<key>other</key>
			<string>%2$lld modelos de chat</string>
