/* Settings → Models advanced */
"Thinking control" = "생각 제어";

/* About: heading of the dependency statement */
"Third-party software" = "서드파티 소프트웨어";

/* Speaker popover: the speaker is the user; saves their voice so later imported recordings can suggest it */
