"sheet %@, rows %lld to %lld" = "工作表%@，第 %lld 行到第 %lld 行";

/* Touch ID prompt: “Vauta is trying to …” */
"show your meetings and context" = "显示你的会议和背景信息";

/* Citation of a presentation slide; the argument is its number
   VoiceOver: a presentation slide; the argument is its number */
"slide %lld" = "幻灯片 %lld";

/* State: a meeting is being recorded right now (not the Settings pane) */
"state.recording" = "正在录音";

/* Status level, accessibility; not the OK button of an alert */
"status.ok" = "正常";

/* Network error reason: the destination check refused the address; lowercase, no final period */
"that address isn’t allowed" = "不允许使用该地址";

/* Network error reason: anything else; lowercase, no final period */
"the connection failed" = "连接失败";

/* Network error reason; lowercase, no final period */
"the network connection was lost" = "网络连接已断开";

/* Network error reason: TLS; lowercase, no final period */
"the secure connection failed" = "安全连接失败";

/* Network error reason: DNS; lowercase, no final period */
"the server’s name can’t be found" = "找不到服务器名称";

/* Event editor: the meeting did not say what time the follow-up is */
"Time not said" = "未提及时间";

/* Copied answer: the claim's quote was found in the transcript */
"verified" = "已验证";

/* Relation between a person and a project */
"works on" = "参与";

/* Words heard in the meeting between quotation marks (a question, or the line that names the next meeting); the argument is the quote. Use the quotation marks of the language */
"“%@”" = "“%@”";

/* Mention whose transcript was purged */
"“%@” (the transcript has expired)" = "“%@”（转录文本已过期）";

/* No comment provided by engineer. */
"“%@” and “%@”" = "“%@”和“%@”";

/* Warning; the first argument is a person's name, the second the error */
"“%@” couldn’t be added. %@" = "无法添加“%@”。%@";

/* No comment provided by engineer. */
"“%@” gets:" = "“%@”将获得：";

/* Meeting people row: who the Others channel is */
"“%@” is" = "“%@”是";

/* Server config error; argument is a host
   Server security warning; argument is a host name */
"“%@” is a name that could point outside your network. Add the server’s private certificate authority or a certificate pin." = "“%@”是一个可能指向网络之外的名称。请添加服务器的私有证书颁发机构或证书锁定值。";

/* Hint under the name field of the other participants when the user typed their own name; the argument is the channel name (Me) */
"“%@” is always you. Name the other participants here." = "“%@”始终是你自己。请在此输入其他参会者的姓名。";

/* Notification body; the first argument is a calendar event title, the second a sentence such as “Zoom is using the microphone.” */
"“%@” is in progress. %@" = "“%@”正在进行。%@";

/* No comment provided by engineer. */
"“%@” is then removed from the list." = "随后“%@”将从列表中移除。";

/* Server config error; argument is a host */
"“%@” isn’t a local network address (10.x, 172.16–31.x, 192.168.x, 100.64–127.x, fc00::/7, fe80::/10, *.local, *.lan, *.home.arpa, *.internal or *.ts.net). Vauta never sends meetings to the internet." = "“%@”不是本地网络地址（10.x、172.16–31.x、192.168.x、100.64–127.x、fc00::/7、fe80::/10、*.local、*.lan、*.home.arpa、*.internal 或 *.ts.net）。Vauta 绝不会将会议发送到互联网。";

/* Server config error */
"“A model server on this Mac” only accepts 127.0.0.1, ::1 or localhost. For another computer, choose “A model server on your network”." = "“这台 Mac 上的模型服务器”只接受 127.0.0.1、::1 或 localhost。若使用其他电脑，请选择“你网络中的模型服务器”。";

/* Settings → Live answers, under Sensitivity */
"“More answers” checks more of what is said, which uses more energy." = "“较多回答”会检查更多发言，因此耗电更多。";

/* Links to earlier meetings (post-meeting actions, Part B) */
"Already in Reminders (added %@)" = "已在“提醒事项”中（%@添加）";
"Also suggests tasks and decisions that repeat earlier meetings. You decide on each one." = "还会建议与之前会议重复的任务和决定。每一条都由你决定。";
"Changed since %@" = "自%@起已更改";
"Couldn’t save the link" = "无法存储链接";
"Different from %@?" = "与%@的不同吗？";
"Dismissed links" = "已舍弃的链接";
"Earlier: %@. Now: %@." = "之前：%1$@。现在：%2$@。";

/* Transcript: under a line of the user's channel that repeats what the other participants said, because the microphone heard them from the speakers */
"Echo of your speakers" = "扬声器回声";
"Mark as Done" = "标记为已完成";

/* Edit menu: the action Undo takes back, marking a transcript line as an echo of the speakers again */
"Mark as Echo" = "标记为回声";
"Not Related" = "不相关";
"Not the Same" = "不是同一个";
"Open the earlier meeting at this item" = "打开此项对应的之前的会议";
"Same Decision" = "相同的决定";
"Same Task" = "相同的任务";
"Same decision as on %@" = "与%@的决定相同";
"Same decision as on %@?" = "与%@的决定相同吗？";
"Same task as on %@" = "与%@的任务相同";
"Same task as on %@?" = "与%@的任务相同吗？";
"Show" = "显示";
"Suggestion" = "建议";
"Undo Link" = "撤销链接";
"Yes, It Changed" = "是，已更改";
"carried over since %@" = "自%@起延续";
"first decided on %@" = "首次决定于%@";
"replaces the decision of %@" = "取代%@的决定";
"Earlier decision: %@" = "之前的决定：%@";
"This task was carried over from earlier meetings" = "此任务从之前的会议延续而来";
"The suggestion changed while you were looking at it. The list is up to date now." = "该建议已发生变化，列表现已更新。";
"%@ · %@: “%@”" = "%@ · %@：“%@”";

/* Badge of the Apple Intelligence option in Settings → Models when this Mac cannot run Apple Intelligence */
"Not available on this Mac" = "在这台 Mac 上不可用";

/* Label of the notes field of a reminder or an event in the editor; Apple’s Reminders and Calendar name this field (zh-Hans 备注), unlike the Notes tab of a meeting */
"event.field.notes" = "备注";

"Transcription on this Mac" = "在这台 Mac 上转写";

"Any call app. No bot joins the call." = "支持任何通话 App。没有机器人加入通话。";

"Minutes and tasks" = "会⁠议⁠纪⁠要和任务";

"Decisions, tasks with owner and date, and open questions." = "决定、带负责人和日期的任务，以及待解决的问题。";

"One question across your meetings, notes and files." = "一个问题，同时查找会议、笔记和文件。";

"Private" = "隐私";

"Audio is never saved. No account, no analytics." = "音频绝不保存。无需账户，不收集分析数据。";

/* Panel tip title while recording: the sound comes out of the Mac’s speakers, a display or AirPlay, not headphones */
"The meeting is playing through speakers" = "会议声音正通过扬声器播放";

/* Panel tip under “The meeting is playing through speakers” */
"The microphone hears the other participants too. Vauta leaves their echo out of the minutes, and headphones avoid it." = "麦克风也会听到其他参与者的声音。Vauta 会把这些回声排除在会议纪要之外，使用耳机可避免这种情况。";
