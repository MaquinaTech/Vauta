/* VoiceOver: a block of rows of a sheet; the arguments are the sheet name and the first and last row numbers */
"sheet %@, rows %lld to %lld" = "シート%@の%lld行目から%lld行目";

/* Touch ID prompt: “Vauta is trying to …” */
"show your meetings and context" = "ミーティングとコンテキストを表示";

/* Citation of a presentation slide; the argument is its number
   VoiceOver: a presentation slide; the argument is its number */
"slide %lld" = "スライド%lld";

/* State: a meeting is being recorded right now (not the Settings pane) */
"state.recording" = "録音中";
"state.paused" = "一時停止中";
"Pause Recording" = "録音を一時停止";
"Resume Recording" = "録音を再開";
"Capture the microphone and the meeting’s sound again" = "マイクとミーティングの音声のキャプチャを再開します";
"Stop capturing for now. The meeting stays open and the pause shows in its transcript." = "いったんキャプチャを停止します。ミーティングは開いたままで、一時停止は文字起こしに表示されます。";
"Recording paused. Nothing is captured until you resume." = "録音を一時停止しました。再開するまで何もキャプチャされません。";
"Recording resumed." = "録音を再開しました。";
"The recording couldn’t resume: %@" = "録音を再開できませんでした：%@";
"The pause couldn’t be saved with the meeting." = "一時停止をミーティングと一緒に保存できませんでした。";
"Paused, %@" = "一時停止中、%@";
"Paused %@ – %@" = "一時停止 %@～%@";
"Paused %@ – %@ (%lld min)" = "一時停止 %@～%@（%lld分）";
"Paused from %@ to the end" = "%@から終了まで一時停止";

/* Status level, accessibility; not the OK button of an alert */
"status.ok" = "OK";

/* Network error reason: the destination check refused the address; lowercase, no final period */
"that address isn’t allowed" = "そのアドレスは許可されていません";

/* Network error reason: anything else; lowercase, no final period */
"the connection failed" = "接続に失敗しました";

/* Network error reason; lowercase, no final period */
"the network connection was lost" = "ネットワーク接続が失われました";

/* Network error reason: TLS; lowercase, no final period */
"the secure connection failed" = "セキュア接続に失敗しました";

/* Network error reason: DNS; lowercase, no final period */
"the server’s name can’t be found" = "サーバ名が見つかりません";

/* Event editor: the meeting did not say what time the follow-up is */
"Time not said" = "時刻は言及なし";

/* Copied answer: the claim's quote was found in the transcript */
"verified" = "確認済み";

/* Relation between a person and a project */
"works on" = "参加";

/* Words heard in the meeting between quotation marks (a question, or the line that names the next meeting); the argument is the quote. Use the quotation marks of the language */
"“%@”" = "「%@」";

/* Mention whose transcript was purged */
"“%@” (the transcript has expired)" = "「%@」（文字起こしの保存期間が終了）";

/* No comment provided by engineer. */
"“%@” and “%@”" = "「%@」と「%@」";

/* Warning; the first argument is a person's name, the second the error */
"“%@” couldn’t be added. %@" = "「%@」を追加できませんでした。%@";

/* No comment provided by engineer. */
"“%@” gets:" = "「%@」に引き継がれるもの：";

/* Meeting people row: who the Others channel is */
"“%@” is" = "「%@」の参加者";

/* Server config error; argument is a host
   Server security warning; argument is a host name */
"“%@” is a name that could point outside your network. Add the server’s private certificate authority or a certificate pin." = "「%@」はネットワーク外を指す可能性のある名前です。サーバのプライベート認証局または証明書のピンを追加してください。";

/* Hint under the name field of the other participants when the user typed their own name; the argument is the channel name (Me) */
"“%@” is always you. Name the other participants here." = "「%@」はいつも自分です。ほかの参加者の名前を入力してください。";

/* Notification body; the first argument is a calendar event title, the second a sentence such as “Zoom is using the microphone.” */
"“%@” is in progress. %@" = "「%@」が進行中です。%@";

/* No comment provided by engineer. */
"“%@” is then removed from the list." = "その後、「%@」はリストから削除されます。";

/* Server config error; argument is a host */
"“%@” isn’t a local network address (10.x, 172.16–31.x, 192.168.x, 100.64–127.x, fc00::/7, fe80::/10, *.local, *.lan, *.home.arpa, *.internal or *.ts.net). Vauta never sends meetings to the internet." = "「%@」はローカルネットワークのアドレス（10.x、172.16–31.x、192.168.x、100.64–127.x、fc00::/7、fe80::/10、*.local、*.lan、*.home.arpa、*.internal、*.ts.net）ではありません。Vautaがミーティングをインターネットに送信することはありません。";

/* Server config error */
"“A model server on this Mac” only accepts 127.0.0.1, ::1 or localhost. For another computer, choose “A model server on your network”." = "「このMac上のモデルサーバ」で使用できるのは127.0.0.1、::1、localhostのみです。別のコンピュータの場合は「ネットワーク上のモデルサーバ」を選択してください。";

/* Settings → Live answers, under Sensitivity */
"“More answers” checks more of what is said, which uses more energy." = "「回答を多く」にすると、発言をより多く確認するため、消費電力が増えます。";

/* Links to earlier meetings (post-meeting actions, Part B) */
"Already in Reminders (added %@)" = "すでにリマインダーにあります（%@に追加）";
"Also suggests tasks and decisions that repeat earlier meetings. You decide on each one." = "以前のミーティングと同じタスクや決定事項も提案します。どれを採用するかは自分で決められます。";
"Changed since %@" = "%@から変更";
"Couldn’t save the link" = "リンクを保存できませんでした";
"Different from %@?" = "%@のものと異なりますか？";
"Dismissed links" = "除外したリンク";
"Earlier: %@. Now: %@." = "以前：%1$@。現在：%2$@。";

/* Transcript: under a line of the user's channel that repeats what the other participants said, because the microphone heard them from the speakers */
"Echo of your speakers" = "スピーカーからのエコー";
"Mark as Done" = "完了にする";

/* Edit menu: the action Undo takes back, marking a transcript line as an echo of the speakers again */
"Mark as Echo" = "エコーとしてマーク";
"Not Related" = "関連なし";
"Not the Same" = "同じではない";
"Open the earlier meeting at this item" = "この項目の以前のミーティングを開く";
"Same Decision" = "同じ決定事項";
"Same Task" = "同じタスク";
"Same decision as on %@" = "%@の決定事項と同じ";
"Same decision as on %@?" = "%@の決定事項と同じですか？";
"Same task as on %@" = "%@のタスクと同じ";
"Same task as on %@?" = "%@のタスクと同じですか？";
"Show" = "表示";
"Suggestion" = "提案";
"Undo Link" = "リンクを取り消す";
"Yes, It Changed" = "はい、変更されました";
"carried over since %@" = "%@から継続";
"first decided on %@" = "初めて決定したのは%@";
"replaces the decision of %@" = "%@の決定事項に代わる";
"Earlier decision: %@" = "以前の決定：%@";
"This task was carried over from earlier meetings" = "このタスクは以前のミーティングから引き継がれています";
"The suggestion changed while you were looking at it. The list is up to date now." = "提案が変更されました。リストを最新の状態にしました。";
"%@ · %@: “%@”" = "%@ · %@：「%@」";

/* Badge of the Apple Intelligence option in Settings → Models when this Mac cannot run Apple Intelligence */
"Not available on this Mac" = "このMacでは利用できません";

/* Label of the notes field of a reminder or an event in the editor; Apple’s Reminders and Calendar name this field (zh-Hans 备注), unlike the Notes tab of a meeting */
"event.field.notes" = "メモ";

"Transcription on this Mac" = "このMacで文字起こし";

"Any call app. No bot joins the call." = "どの通話アプリにも対応。通話にボットは参加しません。";

"Minutes and tasks" = "議事録とタスク";

"Decisions, tasks with owner and date, and open questions." = "決定事項、担当者と期日つきのタスク、未解決の質問。";

"One question across your meetings, notes and files." = "ひとつの質問で、会議・メモ・ファイルをまとめて検索。";

